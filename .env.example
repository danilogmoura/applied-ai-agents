# OpenAI API Key (obter em https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Anthropic API Key (opcional - para comparação)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Modelo padrão (pode ser alterado)
DEFAULT_MODEL=gpt-4o-mini

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# Base URL para providers compatíveis (OpenAI-compatible APIs)
OPENAI_BASE_URL=https://api.openai.com/v1

# Porta da API de produção (módulo P4)
API_PORT=8000

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Aprovação humana ativada (true/false)
HUMAN_IN_THE_LOOP=true
