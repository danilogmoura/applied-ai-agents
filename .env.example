# OpenAI API Key (obter em https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# ---------------------------------------------------------------------------
# Escolha de fornecedor/modelo (switch simples)
# LLM_PROVIDER define qual chave e base URL os run.py usam. Opcoes: openai|qwen
# MODEL escolhe o modelo concreto. Trocar de fornecedor = editar so estas linhas.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai

# --- Qwen (Alibaba Cloud Model Studio / DashScope, API compativel com OpenAI) ---
# Chave no formato sk-sp-... obtida no painel do Qwen Plan.
QWEN_PLAN_API_KEY=coloque-sua-chave-sk-sp-aqui
# Base URL OpenAI-compatible do Qwen Plan (token-plan). Ajuste se seu plano
# usar outro endpoint (ex.: https://dashscope.aliyuncs.com/compatible-mode/v1).
QWEN_BASE_URL=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1
# Modelos disponiveis no seu plano, por exemplo: qwen-plus, qwen3.8-flash, etc.
# MODEL=qwen3.8-flash

# ---------------------------------------------------------------------------
# Thinking / raciocinio (modelos hibridos como qwen3.8-flash)
# ENABLE_THINKING liga ou desliga o raciocinio estendido. Aceita true|false.
#   - Definido aqui  -> forca para QUALQUER modelo escolhido em MODEL.
#   - Nao definido   -> segue o nome do modelo: sufixo '-fast' desliga,
#                       qualquer outro nome liga (default dos modelos hibridos).
# Manda enable_thinking via extra_body (parametro nao-padrao da API OpenAI).
# ---------------------------------------------------------------------------
# ENABLE_THINKING=true

# Anthropic API Key (opcional - para comparação)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Modelo padrão (pode ser alterado)
DEFAULT_MODEL=gpt-4o-mini

# Embedding model
EMBEDDING_MODEL=text-embedding-3-small

# Base URL para providers compatíveis (OpenAI-compatible APIs)
OPENAI_BASE_URL=https://api.openai.com/v1

# Porta da API de produção (módulo P4)
API_PORT=8000

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Aprovação humana ativada (true/false)
HUMAN_IN_THE_LOOP=true
